{
  "name": "@pos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:migrations": "vitest run --config vitest.integration.config.ts tests/integration/migrator.test.ts",
    "db:migrate": "tsx src/database/migrate-cli.ts apply",
    "db:migrate:test": "tsx src/database/migrate-cli.ts apply --test",
    "db:status": "tsx src/database/migrate-cli.ts status",
    "db:status:test": "tsx src/database/migrate-cli.ts status --test",
    "db:seed:demo": "tsx src/database/seed-demo.ts"
  },
  "dependencies": {
    "@pos/contracts": "0.1.0",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "4.22.3",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "pg": "8.16.0",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.9",
    "@types/pg": "8.15.2",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.3",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "vitest": "4.1.11"
  }
}
